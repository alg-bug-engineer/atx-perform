# =============================================================================
# atx-perform 环境变量模板
# 复制为项目根目录 .env 后填入真实值；.env 已 gitignore，勿提交密钥。
# 后端也可使用 backend/.env.example。
# =============================================================================

# ---------- 项目路径 ----------
PROJECT_NAME=atx-perform
DATA_DIR=data
DOCS_DIR=docs
LOGS_DIR=logs
REFERENCES_DIR=references

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---------- API ----------
DATA_MODE=demo
CONTRACT_VERSION=1.0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ALLOW_DEMO_FALLBACK=false
DEEPAGENT_BASE_URL=http://127.0.0.1:8010

# ---------- PostgreSQL（路网 / 指标真源；Live 模块使用）----------
# 推荐完整 DSN；勿把真实密码提交进仓库
PG_DSN=host=PG_HOST port=15432 user=PG_USER password=PG_PASSWORD dbname=ycx
PGHOST=PG_HOST
PGPORT=15432
PGUSER=PG_USER
PGPASSWORD=PG_PASSWORD
PGDATABASE=ycx
PGSCHEMA=road6
PG_FLOW_SCHEMA=xianchang
PG_VERSION_ID=20260501

PG_DIM_INTER_TABLE=dim_inter_info
PG_DIM_LINK_TABLE=dim_link_info
PG_CHANNEL_TABLE=dwd_tfc_rltn_wide_inter_ft_link
PG_LINK_INDEX_TABLE=dws_tfc_link_index_weekly_2mi
PG_FLOW_TABLE=dwd_tfc_lane_roadcross_flow_weekly_5mi
PG_FLOW_CORRELATE_TABLE=ads_ts_inter_turn_flow_correlate_d

# ---------- MySQL（配时 / 业务库，可选）----------
MYSQL_DSN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT_S=10

# ---------- 大模型（可选）----------
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
QWEN_MODEL=qwen-plus
LLM_MOCK=false

# ---------- 地图（可选）----------
AMAP_JS_KEY=
AMAP_JS_SECURITY=
AMAP_WEB_SERVICE_KEY=
