{
  "version": "1.0",
  "description": "交通治理案例标签体系：9个维度，均为多选闭集标签。抽取时只能从candidates中选择，不确定/未提及时该维度输出空数组，禁止自创新词。",
  "dimensions": [
    {
      "key": "时段",
      "description": "案例核心场景/治理措施/效果对应的日内时段和/或日期类型，可多选组合（如早高峰+工作日）。采用'聚焦式'原则：仅当某时段有独立于对比之外的问题描述/措施/效果时才打标签，纯粹作为对比基线提及的时段不打。泛指'高峰'但无法判断早晚时打'不限/未特别说明'。详细判断规则见 scripts/tagging/prompt_template.md",
      "multi_select": true,
      "candidates": ["早高峰", "晚高峰", "平峰", "夜间", "全天/多时段", "工作日", "节假日/大型活动", "不限/未特别说明"]
    },
    {
      "key": "天气",
      "description": "案例是否涉及特定天气条件，绝大多数案例未提及天气应归为'正常天气'",
      "multi_select": true,
      "candidates": ["正常天气", "轻微恶劣天气", "恶劣天气"]
    },
    {
      "key": "地点/几何形态",
      "description": "案例治理对象的道路/路口几何形态类型",
      "multi_select": true,
      "candidates": ["十字路口", "丁字/T型路口", "畸形/多岔路口", "环岛", "相邻路口群/多路口协调", "特殊构造物(桥隧/匝道/立交/高速)", "普通路段(非路口)"]
    },
    {
      "key": "道路等级",
      "description": "案例涉及道路的等级",
      "multi_select": true,
      "candidates": ["主干路", "次干路", "快速路", "高速公路/国省道", "其他/未提及"]
    },
    {
      "key": "交通组成",
      "description": "案例中被重点关注/涉及冲突的交通参与者构成",
      "multi_select": true,
      "candidates": ["机动车", "非机动车/电动车", "行人", "公交车", "货车/大型车"]
    },
    {
      "key": "问题类型",
      "description": "案例中诊断出的核心交通问题类型",
      "multi_select": true,
      "candidates": ["排队溢出", "信号配时/协调不合理", "渠化/几何缺陷", "转向冲突", "慢行冲突", "潮汐流量不均衡", "通行能力不足/饱和度高", "秩序混乱", "事故隐患多发", "施工影响通行"]
    },
    {
      "key": "治理手段",
      "description": "案例中采用的治理措施类型",
      "multi_select": true,
      "candidates": ["信号配时优化", "绿波协调", "特殊车道管控", "渠化/几何改造", "慢行与安全设施改造", "智能化管控", "交通组织管控"]
    },
    {
      "key": "效果指标",
      "description": "案例预期效果所属的类别（仅打类别标签，不要求具体数值）",
      "multi_select": true,
      "candidates": ["通行效率提升", "排队/停车改善", "通行能力/饱和度提升", "安全事故减少", "通行秩序改善"]
    },
    {
      "key": "周边环境",
      "description": "案例治理对象周边的特殊场所/环境类型",
      "multi_select": true,
      "candidates": ["学校周边", "医院周边", "商圈/景区", "客运枢纽", "住宅密集区", "施工区域周边", "无特殊场所/其他"]
    }
  ]
}
