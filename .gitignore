# 环境与密钥
.env
.env.*
!.env.example
!env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# IDE / 系统
.idea/
.vscode/
*.swp
.DS_Store

# 本地参考项目（不入库，保留目录结构）
references/*
!references/.gitkeep

# 运行产物（保留目录结构；幕数据 JSON / 固化技能包入库）
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
!data/1-*.json
!data/skills/
!data/skills/**
!data/tts/
!data/tts/**

# deepagent 原始输出（scripts/pull_deepagent_plan.py 拉取，仅本地留存）
data/deepagent-raw/

# frontend 源码入库；依赖与构建产物不入库（根级已忽略 node_modules/dist）
frontend/.vite/

# 浏览器自动化的临时快照 / 截图
.playwright-cli/
scene-*.png
