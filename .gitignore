# 环境与密钥
.env
.env.*
!.env.example
!env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# IDE / 系统
.idea/
.vscode/
*.swp
.DS_Store

# 本地参考项目（不入库，保留目录结构）
references/*
!references/.gitkeep

# 运行产物（保留目录结构；幕数据 JSON 入库）
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
!data/1-*.json

# frontend 源码入库；依赖与构建产物不入库（根级已忽略 node_modules/dist）
frontend/.vite/
