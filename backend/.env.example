# atx-perform API（后端）
# 复制为 backend/.env 或仓库根 .env；勿提交真实密钥。

DATA_MODE=demo
CONTRACT_VERSION=1.0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 相对仓库根；留空则自动解析为 <repo>/data
DATA_DIR=

# Live 占位：填入后由 traffic / agent 模块接入
PG_DSN=
DEEPAGENT_BASE_URL=http://127.0.0.1:8010
ALLOW_DEMO_FALLBACK=false
