# Demo / production static + API reverse proxy (example).
# frontend/dist served at / ; FastAPI at 127.0.0.1:8000

server {
    listen 80;
    server_name localhost;

    root /var/www/atx-perform/frontend/dist;
    index index.html;

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Trace-Id $request_id;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 420s;
    }

    # 幕 1/2 尚未切网关前，3D 运行时仍可能 fetch /data/1-*.json
    location /data/ {
        alias /var/www/atx-perform/data/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
